<?xml version="1.0" encoding="utf-8"?>
<!--
  Rung 2a probe. The smallest thing that can ask the question.
  No VM config, no guest, no UI, no resources.

  Both permissions are declared here because `pm grant` will only grant a
  permission an app has actually asked for in its manifest. Declaring them
  is free and proves nothing on its own — a sideloaded APK cannot hold a
  signature-level permission just by naming it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pennyspike.probe2a"
    android:versionCode="1"
    android:versionName="2a">

    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />

    <!--
      Rung 3. Unlike the two above, NONE of these four are privileged. They are
      ordinary permissions any app on the Play Store may declare: the first is
      granted automatically at install, the middle two likewise, and only
      POST_NOTIFICATIONS asks the user. That matters — it means the wake
      mechanism rung 3 tests is one a shipping app can actually have, which is
      not true of MANAGE_VIRTUAL_MACHINE.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Rung 3b. RECORD_AUDIO is a RUNTIME permission, so declaring it here only
      buys the right to ask; it is granted by hand over adb for this probe. Two
      things about it are part of the question rather than side detail: whether
      the grant survives a reboot, and whether it can be READ before first
      unlock (runtime grants live in device-encrypted storage, so they should
      be — but "should be" is what this rung is for).

      FOREGROUND_SERVICE_MICROPHONE is what lets a foreground service declare
      the microphone type at all. Like the four above it is an ordinary
      permission any Play Store app may hold — no cable, no signature. That
      matters: if rung 3b answers yes, the mechanism it used is shippable.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      extractNativeLibs=false is not cosmetic here and it is not about install
      size. Microdroid does not unpack the APK; it mounts it in the guest and
      reads lib/arm64-v8a/<name> in place, so the payload has to be STORED
      uncompressed and page-aligned inside the zip. build.sh does the storing
      and the aligning; this attribute is the half of the contract the OS
      reads. With it absent the installer is free to hand back a layout the
      guest cannot mmap, and the failure surfaces in the VM rather than at
      install time.
    -->
    <application
        android:label="Penny probe 2a"
        android:extractNativeLibs="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rung 2b. Same app, same uid, so a VM it creates is owned by the
             same sideloaded identity 2a measured. Exported only so it can be
             started over adb; it has no launcher icon. -->
        <activity
            android:name=".Probe2bActivity"
            android:exported="true" />

        <!-- Rung 2c. Same package and uid again, so the only thing that
             changes between 2b and 2c is which config object gets built. -->
        <activity
            android:name=".Probe2cActivity"
            android:exported="true" />

        <!-- Rung 2d. Same package, same uid, same microdroid as 2b — the
             only change is that setApkPath points at this APK and
             setPayloadBinaryName at a .so we compiled, instead of both
             pointing into the com.android.virt APEX. -->
        <activity
            android:name=".Probe2dActivity"
            android:exported="true" />

        <!-- Rung 3c. Same package, same uid, same microdroid again. The only
             new thing is a vsock connection from this process into the guest,
             which is why it gets its own activity and its own payload .so:
             2d's PennyPayload.so stays in the APK untouched, so the 2d result
             remains reproducible from this same build. -->
        <activity
            android:name=".Probe3cActivity"
            android:exported="true" />

        <!-- Rung 3e-i. Asks whether microdroid will hand a sideloaded app a
             VM big enough to be worth putting a model in. Same package, same
             uid, same microdroid, same 3c payload — the ONLY things that move
             are setMemoryBytes and setCpuTopology, which is what makes a
             failure readable as a memory ceiling rather than as anything else.
             Both are intent extras so the whole bisect runs off one build. -->
        <activity
            android:name=".Probe3eActivity"
            android:exported="true" />

        <!-- Rung 3e-ii. 3e-i asked whether a big VM would be GIVEN; this asks
             whether the guest can actually reach the memory it was given.
             Its own activity and its own VM name, because 3e-i is a committed
             result and is not put back in the frame to answer the next
             question - the same discipline VmService, Penny3dService and
             Probe3eActivity each got. Both figures are intent extras so the
             whole bisect runs off one build. -->
        <activity
            android:name=".Probe3eiiActivity"
            android:exported="true" />

        <!-- Rung 3e-iii. 3e-ii proved 1792MB of a 2048MB VM is genuinely
             writable; this asks whether a model FILE comes out of that same
             budget, because rung 3d logged the guest's /data as tmpfs and
             tmpfs is a RAM disk. Its own activity and its own VM name again:
             3e-i and 3e-ii are committed results and are not put back in the
             frame to answer the next question. The plan it runs is an intent
             extra rather than compiled in, because the guest payload can only
             be rebuilt by hand-opening the Terminal app on the phone. -->
        <activity
            android:name=".Probe3eiiiActivity"
            android:exported="true" />

        <!-- Rungs 3f and 3h, in one activity because they share one guest
             payload. There is no C compiler on the Mac, so every payload
             rebuild costs a hand-opened Terminal app and a trip into the
             phone's Debian guest; 3e-iii proved the way to pay that once, by
             making the payload a command server. 3f asks whether the guest CPU
             is real — eight vCPUs were granted in 3e-i and no payload here has
             ever asked one to calculate anything. 3h asks whether a gigabyte
             can be pushed in over vsock, whose record is 32,000 bytes in a
             single shot. Its own activity, its own VM name and its own store:
             3e-i, 3e-ii and 3e-iii are committed results and are not put back
             in the frame to answer the next question. -->
        <activity
            android:name=".Probe3fActivity"
            android:exported="true" />

        <!-- Rung 3b control. Runs the identical mic probe in the foreground
             with the phone unlocked, where access is unambiguously allowed.
             Without it, silence at boot cannot be told apart from a broken
             probe. -->
        <activity
            android:name=".MicControlActivity"
            android:exported="true" />

        <!-- Rung 3. directBootAware is what lets these two exist before the
             PIN is entered; without it the OS would not even deliver
             LOCKED_BOOT_COMPLETED, and we could not tell "needs a human to
             unlock" apart from "does not wake at all".
             exported=true only so the service can also be started by hand over
             adb as a control run. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- specialUse is the only foreground-service type that honestly
             describes "holds a virtual machine", and it is not on Android 15's
             list of types forbidden from starting at boot. -->
        <service
            android:name=".VmService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a virtual machine alive for the life of the device" />
        </service>

        <!--
          Rung 3b. The assistant declaration, and every line of it is
          load-bearing. The failure mode for getting any of it wrong is that
          the app simply never appears in the Settings assistant picker, with
          nothing logged anywhere to say why.

          directBootAware on THIS service is the trap that appears in no
          document. AOSP's VoiceInteractionManagerService resolves the chosen
          assistant with getServiceInfo(component, 0, user) — flags of zero —
          and before first unlock PackageManager matches only direct-boot-aware
          components. Without the attribute the service does not resolve at
          boot, binds later at unlock instead, and the logs look like success
          while measuring entirely the wrong moment.

          android:permission=BIND_VOICE_INTERACTION is required so that only
          the system may bind these. An assistant without it is rejected.
        -->
        <service
            android:name=".PennyVoiceService"
            android:directBootAware="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>

        <service
            android:name=".PennySessionService"
            android:directBootAware="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <service
            android:name=".PennyRecognitionService"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!--
          Rung 3d. A COPY of VmService, not an edit of it: VmService carries
          the rung 3 wake result proven over four reboots and stays exactly as
          it was. Both start from the same boot broadcast and neither can take
          the other down, so rung 3 keeps reproducing on every reboot 3d uses.

          TWO foreground-service types at once, and each is load-bearing.
          specialUse is what honestly describes holding a VM and is what rung 3
          proved may start at boot. microphone is what lets one service hold
          the microphone at all. Whether a SINGLE service may be both, and
          whether the assistant-role exemption rung 3b found reaches it, is
          part of what rung 3d asks — so the combination is the experiment,
          not a convenience.

          directBootAware for the same reason as everything else here: without
          it the OS does not deliver LOCKED_BOOT_COMPLETED and we would be
          measuring the moment after the PIN instead of the moment after
          power-on.
        -->
        <service
            android:name=".Penny3dService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a virtual machine alive for the life of the device" />
        </service>

        <!-- Rung 3b, attempt site B. Kept separate from VmService on purpose:
             the microphone FGS type is one the system may refuse to start from
             the background, and that refusal kills the service. VmService
             holds a proven rung 3 result and is not going to be risked for it. -->
        <service
            android:name=".MicFgsService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="microphone" />

        <!--
          Rung 3e-v. Is the encrypted store readable BEFORE first unlock? The
          one result left on this handset that can still close the plan down:
          if the store's key is tied to the user's credential then no model can
          be read at boot, and every unattended result in this repo applies
          only to a phone somebody has already unlocked.

          A COPY of Penny3dService, not an edit. Its own VM name, its own
          encrypted store, its own written file, so it cannot strand or be
          stranded by anything that already carries a committed result.

          directBootAware is the whole point of it and not boilerplate. Without
          the attribute the OS does not deliver LOCKED_BOOT_COMPLETED, the
          service would start at first unlock instead, and the log would look
          like a success while measuring precisely the wrong moment.

          specialUse alone: this one holds a VM and never asks for a
          microphone, so the combined type rung 3d proved is not needed here
          and would add a variable for nothing.
        -->
        <service
            android:name=".Penny3evService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a virtual machine alive for the life of the device" />
        </service>

        <!--
          Rung 3g-i. Will a 2048MB VM start at boot, locked, with nobody in the
          room? Every 2GB figure in this repo was taken unlocked, in the
          foreground, over adb, on an idle phone; rung 3d's unattended VMs were
          256MB. Those two results have never been in the same room.

          Also a COPY, for the same reason as the others. It brings up a 256MB
          control and then the 2048MB test from this one service on one boot,
          so that "2048MB is too much at boot" and "the service is shaped
          wrong" stay separable.
        -->
        <service
            android:name=".Penny3giService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a virtual machine alive for the life of the device" />
        </service>

        <!--
          ENDURANCE, and the store-creation case, in one service.

          A COPY of Penny3evService with its own VM name, its own encrypted
          store and its own notification id. Penny3evService is untouched and
          still holds rung 3e-v's committed result.

          Two questions, one VM. `pennysoak` is a name that has never existed
          on this device, so getOrCreate has no prior directory and the FIRST
          boot answers "can a NEW encrypted store be created before first
          unlock" — the first-boot-after-factory-reset case, which 3e-v never
          reached because its boot 1 died on the stale-config trap. That answer
          lands in the first twenty seconds. Everything after it is the soak:
          nothing in this repo has ever run longer than about twenty seconds.

          directBootAware for the same reason as everything else here: without
          it the OS does not deliver LOCKED_BOOT_COMPLETED and the pre-unlock
          question cannot be asked at all.
        -->
        <service
            android:name=".PennySoakService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a virtual machine alive for the life of the device" />
        </service>
    </application>
</manifest>
